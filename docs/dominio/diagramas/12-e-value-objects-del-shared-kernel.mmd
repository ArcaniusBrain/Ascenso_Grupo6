classDiagram
  direction LR
  namespace Shared_Kernel {
    class Dinero {
      <<Value Object>>
      +Cantidad: decimal
      +Moneda: string
    }
    class Cedula {
      <<Value Object>>
      +Numero: string
    }
    class Contacto {
      <<Value Object>>
      +Correo: string
      +Telefono: string
    }
    class VentanaFechas {
      <<Value Object>>
      +Apertura: date
      +Cierre: date
    }
    class FechaLimite {
      <<Value Object>>
      +Fecha: date
    }
    class Promedio {
      <<Value Object>>
      +Valor: decimal
    }
    class Justificacion {
      <<Value Object>>
      +Texto: string
    }
    class ReferenciaArchivo {
      <<Value Object>>
      +RutaFirebase: string
    }
    class CodigoPeriodo {
      <<Value Object>>
      +Valor: string
    }
  }
