rankdir=LR;
x[label="Excel / CSV histórico",shape=box];st[label="Staging normalizado",shape=box];dry[label="Dry run sin escribir\nreporte de errores",shape=box,fillcolor="#fff2d7"];
load[label="Comandos idempotentes\nS2 → S1 → S3 → S4 → S5",shape=box];pg[label="PostgreSQL\nagregados + RegistroDecision",shape=cylinder];
