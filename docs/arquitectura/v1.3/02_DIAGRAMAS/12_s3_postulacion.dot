digraph G { graph [label="S3 | Postulación y Evaluación: puertos, selección y eventos",labelloc=t,labeljust=l,fontname="DejaVu Sans",fontsize=21,fontcolor="#123552",bgcolor="white",pad=0.35,nodesep=.4,ranksep=.7,splines=polyline,compound=true,overlap=false]; node [shape=component,fontname="DejaVu Sans",fontsize=11,style="filled,rounded",color="#19619a",fillcolor="#e8f3fb",fontcolor="#183b54",margin="0.20,0.14"]; edge [fontname="DejaVu Sans",fontsize=9,color="#607d8b",arrowsize=.75,penwidth=1.25];

rankdir=LR;
api[label="S3 API REST"];
app[label="Application\nPostular, Verificar, Evaluar,\nConsolidar, GenerarRanking, SugerirEspera"];
