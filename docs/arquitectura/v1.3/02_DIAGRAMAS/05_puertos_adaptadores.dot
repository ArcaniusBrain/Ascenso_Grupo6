digraph G { graph [label="ASCENSO | Puertos y adaptadores — contratos verificables",labelloc=t,labeljust=l,fontname="Arial",fontsize=20,fontcolor="#102c49",bgcolor="white",pad=0.28,nodesep=0.55,ranksep=0.85,splines=polyline,compound=true]; node [shape=component,fontname="Arial",fontsize=12,style="filled,rounded",color="#1765a3",fillcolor="#edf6f9",fontcolor="#102c49",margin="0.20,0.14"]; edge [fontname="Arial",fontsize=10,color="#697a8c",arrowsize=0.75,penwidth=1.35];

