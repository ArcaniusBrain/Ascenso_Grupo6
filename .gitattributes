# Normaliza los finales de línea: en el repositorio siempre LF.
* text=auto eol=lf

# Archivos de Windows que necesitan CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Binarios
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.xlsx binary
*.docx binary
*.zip  binary
