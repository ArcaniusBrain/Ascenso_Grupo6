# ==============================================================================
# ASCENSO Frontend (Next.js App Router BFF - ADR-28)
# Copia este archivo a .env.local para desarrollo local. Nunca subas .env.local.
# ==============================================================================

# Clave secreta para cifrar cookies HttpOnly de sesion (minimo 32 caracteres).
ASCENSO_SESSION_SECRET=reemplazar-con-secreto-local-aleatorio-de-al-menos-32-caracteres

# URL del API Gateway (YARP). Si se define, todas las rutas /api/v1/* entran por YARP.
# Ejemplo en despliegue o con YARP local: http://127.0.0.1:5000
ASCENSO_GATEWAY_URL=

# Overrides opcionales por microservicio para desarrollo local directo sin YARP.
# Solo se usan cuando ASCENSO_GATEWAY_URL esta vacio.
ASCENSO_S1_URL=http://127.0.0.1:5101
ASCENSO_S2_URL=http://127.0.0.1:5102
ASCENSO_S3_URL=http://127.0.0.1:5103
ASCENSO_S4_URL=http://127.0.0.1:5104
ASCENSO_S5_URL=http://127.0.0.1:5105
ASCENSO_S6_URL=http://127.0.0.1:5106
