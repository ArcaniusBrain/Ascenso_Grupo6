{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "s1-auth": { "ClusterId": "cluster-s1", "Match": { "Path": "/api/v1/auth/{**catch-all}" } },
      "s1-usuarios": { "ClusterId": "cluster-s1", "Match": { "Path": "/api/v1/usuarios/{**catch-all}" } },
      "s1-tipos-usuario": { "ClusterId": "cluster-s1", "Match": { "Path": "/api/v1/tipos-usuario/{**catch-all}" } },
      "s1-otp": { "ClusterId": "cluster-s1", "Match": { "Path": "/api/v1/otp/{**catch-all}" } },

      "s2-periodos": { "ClusterId": "cluster-s2", "Match": { "Path": "/api/v1/periodos/{**catch-all}" } },
      "s2-universidades": { "ClusterId": "cluster-s2", "Match": { "Path": "/api/v1/universidades/{**catch-all}" } },
      "s2-programas": { "ClusterId": "cluster-s2", "Match": { "Path": "/api/v1/programas/{**catch-all}" } },
      "s2-donantes": { "ClusterId": "cluster-s2", "Match": { "Path": "/api/v1/donantes/{**catch-all}" } },

      "s3-convocatorias": { "ClusterId": "cluster-s3", "Match": { "Path": "/api/v1/convocatorias/{**catch-all}" } },
      "s3-postulantes": { "ClusterId": "cluster-s3", "Match": { "Path": "/api/v1/postulantes/{**catch-all}" } },
      "s3-postulaciones": { "ClusterId": "cluster-s3", "Match": { "Path": "/api/v1/postulaciones/{**catch-all}" } },
      "s3-evaluaciones": { "ClusterId": "cluster-s3", "Match": { "Path": "/api/v1/evaluaciones/{**catch-all}" } },
      "s3-rubricas": { "ClusterId": "cluster-s3", "Match": { "Path": "/api/v1/rubricas/{**catch-all}" } },

      "s4-ofertas": { "ClusterId": "cluster-s4", "Match": { "Path": "/api/v1/ofertas/{**catch-all}" } },
      "s4-becas": { "ClusterId": "cluster-s4", "Match": { "Path": "/api/v1/becas/{**catch-all}" } },
      "s4-desembolsos": { "ClusterId": "cluster-s4", "Match": { "Path": "/api/v1/desembolsos/{**catch-all}" } },
      "s4-pagos": { "ClusterId": "cluster-s4", "Match": { "Path": "/api/v1/pagos/{**catch-all}" } },

      "s5-seguimiento": { "ClusterId": "cluster-s5", "Match": { "Path": "/api/v1/seguimiento/{**catch-all}" } },
      "s5-reportes-academicos": { "ClusterId": "cluster-s5", "Match": { "Path": "/api/v1/reportes-academicos/{**catch-all}" } },
      "s5-renovaciones": { "ClusterId": "cluster-s5", "Match": { "Path": "/api/v1/renovaciones/{**catch-all}" } },
      "s5-pausas": { "ClusterId": "cluster-s5", "Match": { "Path": "/api/v1/pausas/{**catch-all}" } },

      "s6-consentimientos": { "ClusterId": "cluster-s6", "Match": { "Path": "/api/v1/consentimientos-donantes/{**catch-all}" } },
      "s6-reportes": { "ClusterId": "cluster-s6", "Match": { "Path": "/api/v1/reportes/{**catch-all}" } },
      "s6-notificaciones": { "ClusterId": "cluster-s6", "Match": { "Path": "/api/v1/notificaciones/{**catch-all}" } },
      "s6-consultas": { "ClusterId": "cluster-s6", "Match": { "Path": "/api/v1/consultas/{**catch-all}" } },
      "s6-indicadores": { "ClusterId": "cluster-s6", "Match": { "Path": "/api/v1/indicadores/{**catch-all}" } },
      "s6-hubs-signalr": { "ClusterId": "cluster-s6", "Match": { "Path": "/hubs/{**catch-all}" } }
    },
    "Clusters": {
      "cluster-s1": { "Destinations": { "d1": { "Address": "http://s1-identidad:5101" } } },
      "cluster-s2": { "Destinations": { "d1": { "Address": "http://s2-catalogo-fondos:5102" } } },
      "cluster-s3": { "Destinations": { "d1": { "Address": "http://s3-postulacion-evaluacion:5103" } } },
      "cluster-s4": { "Destinations": { "d1": { "Address": "http://s4-becas:5104" } } },
      "cluster-s5": { "Destinations": { "d1": { "Address": "http://s5-seguimiento:5105" } } },
      "cluster-s6": { "Destinations": { "d1": { "Address": "http://s6-comunicaciones:5106" } } }
    }
  }
}
